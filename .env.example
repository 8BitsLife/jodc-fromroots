# ==============================================================================
# JODC — Environment Variables Configuration
# ==============================================================================
# Copy this file to .env or .env.local and fill in your keys:
# cp .env.example .env

# ------------------------------------------------------------------------------
# 1. Supabase Credentials (Required for Repo of the Week Backend)
# ------------------------------------------------------------------------------
# Get these from your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. GitHub Token (Required for Live GitHub Stats Sync Worker)
# ------------------------------------------------------------------------------
# Generate at: https://github.com/settings/tokens (classic token with 'public_repo' scope)
GITHUB_TOKEN=ghp_yourGitHubPersonalAccessTokenHere

# ------------------------------------------------------------------------------
# 3. Supabase Service Role Key (Required for Background Sync Script / Admin)
# ------------------------------------------------------------------------------
# Secret key from Supabase Dashboard -> Project Settings -> API (Keep private!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
